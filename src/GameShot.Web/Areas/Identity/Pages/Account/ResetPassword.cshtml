@page
@model GameShot.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "비밀번호 재설정";
}

<div class="account-box mx-auto">
    <h1 class="h4 mb-4 text-center">새 비밀번호 정하기</h1>
    <form method="post" class="card">
        <input asp-for="Input.UserId" type="hidden" />
        <input asp-for="Input.Code" type="hidden" />
        <div class="card-body vstack gap-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-0" role="alert"></div>
            <div>
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">8자 이상, 영문 소문자와 숫자를 포함하세요.</div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-dark w-100">비밀번호 바꾸기</button>
        </div>
    </form>
    <p class="text-center small mt-3"><a asp-page="./ForgotPassword">재설정 메일 다시 받기</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
