@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "메일을 확인하세요";
}

<div class="text-center py-5">
    <h1 class="h4">메일을 확인하세요</h1>
    <p class="text-muted">
        입력한 이메일로 가입한 계정이 있으면 비밀번호 재설정 링크를 보냈습니다.<br />
        몇 분 안에 오지 않으면 스팸함을 확인하거나 잠시 후 다시 요청하세요.
    </p>
    <a class="btn btn-dark" asp-page="./Login">로그인으로</a>
</div>
