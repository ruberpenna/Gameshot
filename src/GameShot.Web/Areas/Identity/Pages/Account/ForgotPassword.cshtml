@page
@model GameShot.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "비밀번호 찾기";
}

<div class="account-box mx-auto">
    <h1 class="h4 mb-2 text-center">비밀번호 찾기</h1>
    <p class="text-muted small text-center mb-4">가입한 이메일로 비밀번호 재설정 링크를 보내 드립니다.</p>
    <form method="post" class="card">
        <div class="card-body vstack gap-3">
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-dark w-100">재설정 메일 받기</button>
        </div>
    </form>
    <p class="text-center small mt-3"><a asp-page="./Login">로그인으로 돌아가기</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
