@model IReadOnlyList<AdminOrderRow>

@if (Model.Count == 0)
{
    <p class="text-muted small p-3 mb-0">주문이 없습니다.</p>
    return;
}

<div class="table-responsive">
    <table class="table table-hover admin-table mb-0">
        <thead class="table-light small">
            <tr>
                <th>주문번호</th>
                <th>주문일시</th>
                <th>회원 / 받는 분</th>
                <th>상품</th>
                <th class="num">금액</th>
                <th>상태</th>
            </tr>
        </thead>
        <tbody class="small">
            @foreach (var o in Model)
            {
                <tr>
                    <td><a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-orderNumber="@o.OrderNumber">@o.OrderNumber</a></td>
                    <td>@KoreanTime.FromUtc(o.CreatedAt).ToString("MM.dd HH:mm")</td>
                    <td>@o.CustomerEmail<br /><span class="text-muted">@o.RecipientName</span></td>
                    <td class="text-truncate" style="max-width: 16rem">
                        @o.FirstItemTitle
                        @if (o.ItemCount > 1)
                        {
                            <span class="text-muted">외 @(o.ItemCount - 1)건</span>
                        }
                    </td>
                    <td class="num">@o.Total.ToString("N0")원</td>
                    <td><partial name="~/Views/Orders/_OrderStatusBadge.cshtml" model="o.Status" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>
