@model WishlistViewModel
@{
    ViewData["Title"] = "찜";
}

<h1 class="h4 mb-3">마이페이지</h1>
<partial name="~/Views/My/_MyNav.cshtml" />

@if (Model.Result.Items.Count == 0)
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">찜한 상품이 없습니다. 상품의 ♡를 눌러 찜해 보세요.</p>
        <a class="btn btn-dark" asp-controller="Products" asp-action="Index">상품 보러 가기</a>
    </div>
    return;
}

<p class="small text-muted">찜한 상품 @Model.Result.TotalCount.ToString("N0")개</p>
<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
    @foreach (var card in Model.Result.Items)
    {
        <partial name="_ProductCard" model="new ProductCardModel(card, Model.Today, true)" />
    }
</div>

@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-4" aria-label="페이지">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.Result.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Result.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
