@{
    var action = ViewContext.RouteData.Values["action"] as string;
    var controller = ViewContext.RouteData.Values["controller"] as string;
    string Active(string c, string a) => controller == c && (a == "*" || action == a) ? "active" : "";
}
<ul class="nav nav-pills platform-tabs mb-4">
    <li class="nav-item"><a class="nav-link @Active("Orders", "*")" asp-controller="Orders" asp-action="Index">주문 내역</a></li>
    <li class="nav-item"><a class="nav-link @Active("Wishlist", "Index")" asp-controller="Wishlist" asp-action="Index">찜</a></li>
    <li class="nav-item"><a class="nav-link @Active("My", "Coupons")" asp-controller="My" asp-action="Coupons">쿠폰</a></li>
    <li class="nav-item"><a class="nav-link @Active("My", "Points")" asp-controller="My" asp-action="Points">포인트</a></li>
</ul>
