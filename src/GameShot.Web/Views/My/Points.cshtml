@using GameShot.Web.Models.Benefits
@using GameShot.Web.Services
@inject Microsoft.Extensions.Options.IOptions<ShopOptions> Shop
@model List<PointTransaction>
@{
    ViewData["Title"] = "포인트";
    var balance = (int)ViewData["Balance"]!;
}

<h1 class="h4 mb-3">마이페이지</h1>
<partial name="_MyNav" />

<div class="card mb-4" style="max-width: 28rem">
    <div class="card-body">
        <div class="small text-muted">사용 가능 포인트</div>
        <div class="display-6 fw-bold">@balance.ToString("N0")P</div>
        <div class="small text-muted">1P = 1원 · 배송 완료 시 실결제액(배송비 제외)의 @((Shop.Value.PointEarnRate * 100).ToString("0.#"))% 적립</div>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">포인트 내역이 없습니다.</p>
    return;
}

<ul class="list-group">
    @foreach (var p in Model)
    {
        var label = p.Type switch
        {
            PointType.Earn => "적립",
            PointType.Use => "사용",
            PointType.Refund => "반환",
            _ => "조정",
        };
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <span class="badge @(p.Amount > 0 ? "text-bg-primary" : "text-bg-secondary") me-2">@label</span>
                @p.Description
                <div class="small text-muted">@KoreanTime.FromUtc(p.CreatedAt).ToString("yyyy.MM.dd HH:mm")</div>
            </div>
            <div class="text-end">
                <div class="fw-semibold @(p.Amount > 0 ? "text-primary" : "")">@(p.Amount > 0 ? "+" : "")@p.Amount.ToString("N0")P</div>
                <div class="small text-muted">잔액 @p.BalanceAfter.ToString("N0")P</div>
            </div>
        </li>
    }
</ul>
