@using GameShot.Web.Services
@model ProductListViewModel
@{
    ViewData["Title"] = "상품";
    var f = Model.Filter;

    // 현재 필터를 유지한 채 일부 값만 바꾼 링크용 라우트 값
    Dictionary<string, string?> Route(string? platform = null, int? page = null, bool keepPlatform = true) => new()
    {
        ["Platform"] = keepPlatform ? f.Platform : platform,
        ["GenreId"] = f.GenreId?.ToString(),
        ["Q"] = f.Q,
        ["Sort"] = f.Sort == ProductSort.Newest ? null : f.Sort.ToString(),
        ["InStockOnly"] = f.InStockOnly ? "true" : null,
        ["Page"] = page is > 1 ? page.ToString() : null,
    };
}

<h1 class="h4 mb-3">상품</h1>

<ul class="nav nav-pills platform-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(string.IsNullOrEmpty(f.Platform) ? "active" : "")" asp-action="Index" asp-all-route-data="Route(keepPlatform: false)">전체</a>
    </li>
    @foreach (var platform in Model.Platforms)
    {
        <li class="nav-item">
            <a class="nav-link @(f.Platform == platform.Code ? "active" : "")" asp-action="Index" asp-all-route-data="Route(platform.Code, keepPlatform: false)">@platform.Name</a>
        </li>
    }
</ul>

<form method="get" asp-action="Index" class="row g-2 align-items-center mb-4">
    <input type="hidden" name="Platform" value="@f.Platform" />
    <div class="col-12 col-md-4">
        <input type="search" name="Q" value="@f.Q" class="form-control" placeholder="게임 이름, 퍼블리셔 검색" />
    </div>
    <div class="col-6 col-md-2">
        <select name="GenreId" class="form-select">
            <option value="">모든 장르</option>
            @foreach (var genre in Model.Genres)
            {
                <option value="@genre.Id" selected="@(f.GenreId == genre.Id)">@genre.Name</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select name="Sort" class="form-select">
            <option value="Newest" selected="@(f.Sort == ProductSort.Newest)">최신 발매순</option>
            <option value="PriceAsc" selected="@(f.Sort == ProductSort.PriceAsc)">낮은 가격순</option>
            <option value="PriceDesc" selected="@(f.Sort == ProductSort.PriceDesc)">높은 가격순</option>
            <option value="Title" selected="@(f.Sort == ProductSort.Title)">이름순</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="InStockOnly" value="true" id="inStockOnly" checked="@f.InStockOnly" />
            <label class="form-check-label" for="inStockOnly">재고 있는 상품만</label>
        </div>
    </div>
    <div class="col-6 col-md-2 d-grid">
        <button type="submit" class="btn btn-dark">검색</button>
    </div>
</form>

<p class="small text-muted">총 @Model.Result.TotalCount.ToString("N0")개</p>

@if (Model.Result.Items.Count == 0)
{
    <p class="text-muted py-5 text-center">조건에 맞는 상품이 없습니다.</p>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var card in Model.Result.Items)
        {
            <partial name="_ProductCard" model="(card, Model.Today)" />
        }
    </div>
}

@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-4" aria-label="페이지">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.Result.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Result.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="Route(page: p)">@p</a>
                </li>
            }
        </ul>
    </nav>
}
