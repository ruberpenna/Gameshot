@using GameShot.Web.Models.Catalog
@model ProductDetailViewModel
@{
    var p = Model.Product;
    ViewData["Title"] = p.Title;

    // 별점을 ★★★★☆ 형태로 (반올림)
    static string Stars(double rating)
    {
        var full = (int)Math.Round(rating, MidpointRounding.AwayFromZero);
        return new string('★', full) + new string('☆', 5 - full);
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">상품</a></li>
        @if (p.Genre is not null)
        {
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-GenreId="@p.GenreId">@p.Genre.Name</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@p.Title</li>
    </ol>
</nav>

<div class="row g-4 g-lg-5 mt-1">
    <div class="col-md-5">
        <div class="detail-gallery">
            @if (p.ThumbnailPath is not null)
            {
                <img src="@p.ThumbnailPath" alt="@p.Title" class="img-fluid detail-thumb" />
            }
        </div>
    </div>
    <div class="col-md-7">
        <div class="d-flex flex-wrap gap-1 mb-2">
            @foreach (var platformName in p.Variants.Select(v => v.Platform.Name).Distinct())
            {
                <span class="pf-badge @GameShot.Web.Services.PlatformStyle.CssClass(platformName)">@platformName</span>
            }
            @if (Model.IsPreorder)
            {
                <span class="badge text-bg-primary">예약판매 · @p.ReleaseDate?.ToString("yyyy.MM.dd") 발매</span>
            }
        </div>
        <h1 class="detail-title mb-2">@p.Title</h1>
        @if (Model.Reviews.Summary.Count > 0)
        {
            <a href="#reviews" class="small text-body text-decoration-none d-inline-block mb-2">
                <span class="rating-stars">@Stars(Model.Reviews.Summary.Average)</span>
                <strong>@Model.Reviews.Summary.Average.ToString("0.0")</strong>
                <span class="text-muted">리뷰 @Model.Reviews.Summary.Count.ToString("N0")개</span>
            </a>
        }
        @if (!string.IsNullOrEmpty(p.Summary))
        {
            <p class="text-muted mb-0">@p.Summary</p>
        }

        <dl class="detail-specs">
            @if (!string.IsNullOrEmpty(p.Publisher))
            {
                <dt>퍼블리셔</dt>
                <dd>@p.Publisher</dd>
            }
            @if (p.ReleaseDate is { } release)
            {
                <dt>발매일</dt>
                <dd>@release.ToString("yyyy년 M월 d일")</dd>
            }
            @if (p.Genre is not null)
            {
                <dt>장르</dt>
                <dd>@p.Genre.Name</dd>
            }
        </dl>

        <h2 class="h6 mb-2">구매 옵션</h2>
        @if (p.Variants.Count == 0)
        {
            <p class="text-muted">현재 판매 중인 옵션이 없습니다.</p>
        }
        else
        {
            var firstAvailable = p.Variants.FirstOrDefault(v => !v.IsSoldOut);
            <form method="post" asp-controller="Cart" asp-action="Add" class="purchase-form">
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div class="option-list">
                    @foreach (var v in p.Variants)
                    {
                        <label class="option-card @(v.IsSoldOut ? "is-soldout" : "")">
                            <input class="form-check-input" type="radio" name="variantId" value="@v.Id"
                                   checked="@(v == firstAvailable)" disabled="@v.IsSoldOut" />
                            <span class="flex-grow-1 min-w-0">
                                <span class="pf-badge @GameShot.Web.Services.PlatformStyle.CssClass(v.Platform.Name) me-1">@GameShot.Web.Services.PlatformStyle.ShortName(v.Platform.Name)</span>
                                <span class="fw-semibold">@v.Edition</span>
                                <span class="text-muted small">· @v.Language</span>
                                @if (v.Condition == ItemCondition.Used)
                                {
                                    <span class="badge text-bg-warning ms-1">중고</span>
                                }
                                <span class="d-block small mt-1">
                                    @if (v.IsSoldOut)
                                    {
                                        <span class="text-muted">품절</span>
                                    }
                                    else if (v.Stock <= 5)
                                    {
                                        <span class="text-danger">남은 수량 @(v.Stock)개</span>
                                    }
                                    else
                                    {
                                        <span class="text-success"><i class="bi bi-check-circle"></i> 바로 구매 가능</span>
                                    }
                                </span>
                            </span>
                            <span class="text-end text-nowrap">
                                @if (v.IsDiscounted)
                                {
                                    <span class="d-block small"><span class="gs-price-rate">@v.DiscountRate%</span><span class="gs-price-list ms-0">@v.ListPrice.ToString("N0")원</span></span>
                                }
                                <span class="gs-price">@v.SalePrice.ToString("N0")원</span>
                            </span>
                        </label>
                    }
                </div>
                <div class="buy-box">
                    <select name="quantity" class="form-select w-auto" aria-label="수량" disabled="@(firstAvailable is null)">
                        @for (var q = 1; q <= GameShot.Web.Services.CartService.MaxQuantityPerItem; q++)
                        {
                            <option value="@q">@(q)개</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-dark flex-grow-1" disabled="@(firstAvailable is null)">
                        <i class="bi bi-bag-plus"></i> @(firstAvailable is null ? "품절" : "장바구니 담기")
                    </button>
                </div>
            </form>
        }
        <div class="d-flex align-items-center justify-content-between mt-2">
            <div class="ship-note">
                <i class="bi bi-truck"></i>
                @GameShot.Web.Services.CartService.FreeShippingThreshold.ToString("N0")원 이상 무료배송 (미만 @GameShot.Web.Services.CartService.ShippingFee.ToString("N0")원)
            </div>
            <partial name="_WishButton" model="(p.Id, Model.IsWished, false)" />
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(p.Description) || p.Images.Count > 0)
{
    <hr class="my-5" />
    <h2 class="h5 mb-3">상품 정보</h2>
    @if (!string.IsNullOrEmpty(p.Description))
    {
        <p style="white-space: pre-line">@p.Description</p>
    }
    <div class="text-center">
        @foreach (var image in p.Images)
        {
            <img src="@image.Path" alt="@p.Title 상세 이미지" class="img-fluid mb-3" loading="lazy" />
        }
    </div>
}

<hr class="my-5" />
<partial name="_Reviews" model="Model" />
