@using GameShot.Web.Services
@model List<OrderSummary>
@{
    ViewData["Title"] = "주문 내역";
}

<h1 class="h4 mb-3">마이페이지</h1>
<partial name="~/Views/My/_MyNav.cshtml" />

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">아직 주문한 상품이 없습니다.</p>
        <a class="btn btn-dark" asp-controller="Products" asp-action="Index">상품 보러 가기</a>
    </div>
    return;
}

<ul class="list-group">
    @foreach (var order in Model)
    {
        <li class="list-group-item">
            <a class="d-flex gap-3 text-body text-decoration-none" asp-action="Details" asp-route-orderNumber="@order.OrderNumber">
                <div class="cart-thumb flex-shrink-0">
                    @if (order.ThumbnailPath is not null)
                    {
                        <img src="@order.ThumbnailPath" alt="" />
                    }
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="small text-muted">
                        @KoreanTime.FromUtc(order.CreatedAt).ToString("yyyy.MM.dd") · @order.OrderNumber
                    </div>
                    <div class="fw-semibold">
                        @order.FirstItemTitle
                        @if (order.ItemCount > 1)
                        {
                            <span class="fw-normal text-muted">외 @(order.ItemCount - 1)건</span>
                        }
                    </div>
                    <div class="mt-1"><partial name="_OrderStatusBadge" model="order.Status" /></div>
                </div>
                <div class="text-nowrap fw-semibold">@order.Total.ToString("N0")원</div>
            </a>
        </li>
    }
</ul>
