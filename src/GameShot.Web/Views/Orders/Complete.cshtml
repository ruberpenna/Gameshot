@using GameShot.Web.Models.Ordering
@model Order
@{
    ViewData["Title"] = "주문 완료";
}

<div class="text-center py-4">
    <div class="display-6 mb-2">🎮</div>
    <h1 class="h4">주문이 완료되었습니다</h1>
    <p class="text-muted">주문번호 <strong class="text-body">@Model.OrderNumber</strong></p>
</div>

<div class="mx-auto" style="max-width: 40rem">
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6 mb-3">배송지</h2>
            <p class="mb-0 small">
                @Model.Shipping.RecipientName · @Model.Shipping.Phone<br />
                (@Model.Shipping.PostalCode) @Model.Shipping.Address1 @Model.Shipping.Address2
                @if (Model.Shipping.Memo is not null)
                {
                    <br /><span class="text-muted">@Model.Shipping.Memo</span>
                }
            </p>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 mb-3">주문 상품</h2>
            <partial name="_OrderItems" model="Model" />
        </div>
    </div>
    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-dark" asp-action="Details" asp-route-orderNumber="@Model.OrderNumber">주문 상세 보기</a>
        <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index">쇼핑 계속하기</a>
    </div>
</div>
